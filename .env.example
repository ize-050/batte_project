# Server port; Render provides PORT automatically. Local default: 4179.
PORT=4179
# Only needed when frontend and backend use different origins. No trailing slash.
# Local legacy preview: http://127.0.0.1:4178,http://localhost:4178
ALLOWED_ORIGINS=
# Build-time frontend URL. Leave empty for same-host hosting.
# PUBLIC_WS_URL=wss://four-clans-api.onrender.com/ws
PUBLIC_WS_URL=
# Limit concurrent rooms. This is a cap, not a measured free-tier capacity guarantee.
MAX_ROOMS=8
